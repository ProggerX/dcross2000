<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Widget.DCross2000.Slider" parent="Widget.Material3Expressive.Slider.Medium">
		<item name="labelBehavior">gone</item>
		<item name="tickVisible">false</item>
	</style>

	<!-- Tonal button without a minimum width or side padding, so several share one row on small screens. -->
	<style name="Widget.DCross2000.Button.Compact" parent="Widget.Material3Expressive.Button.TonalButton">
		<item name="android:minWidth">0dp</item>
		<item name="android:paddingLeft">0dp</item>
		<item name="android:paddingRight">0dp</item>
	</style>

	<!-- Root of a custom dialog view; Material 3 dialogs inset their content by 24 dp. -->
	<style name="DCross2000.DialogContent" parent="">
		<item name="android:paddingLeft">24dp</item>
		<item name="android:paddingRight">24dp</item>
		<item name="android:paddingBottom">8dp</item>
	</style>

	<!-- Full width form field with the label as its floating hint, see FormTextInputLayout. -->
	<style name="Widget.DCross2000.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">8dp</item>
	</style>
	<!-- Read only picker field; tapping it opens a selection dialog. -->
	<style name="Widget.DCross2000.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">8dp</item>
	</style>

	<!-- Theme of the framework AlertDialogs built by the platform preferences. The Material 3
	     framework overlays are full platform dialog themes (the default one is the dark
	     Theme.Material.Dialog.Alert), and they keep the square platform window, which is
	     replaced with the Material 3 shape and surface colour. -->
	<style name="ThemeOverlay.DCross2000.Dialog.Framework" parent="ThemeOverlay.Material3Expressive.Dialog.Alert.Framework">
		<item name="android:windowBackground">@drawable/dialog_background_m3</item>
	</style>
	<style name="ThemeOverlay.DCross2000.Dialog.Framework.Light" parent="ThemeOverlay.Material3Expressive.Light.Dialog.Alert.Framework">
		<item name="android:windowBackground">@drawable/dialog_background_m3</item>
	</style>

	<!-- Material 3 header for the platform preference framework; applied through
	     android:preferenceCategoryStyle in themes.xml. The framework's
	     Preference.Material.Category style is private, so the layout item is repeated. -->
	<style name="Preference.DCross2000.Category" parent="">
		<item name="android:layout">@layout/preference_category_m3</item>
		<item name="android:selectable">false</item>
	</style>

	<!-- NType82 is registered by Nothing OS; on any other device the lookup falls
	     back to the system sans, which is already the user's chosen font (Geist). -->
	<style name="TextAppearance.DCross2000.Brand" parent="TextAppearance.Material3.TitleLarge">
		<item name="android:fontFamily">NType82-Headline</item>
	</style>
	<style name="TextAppearance.DCross2000.BarBrand" parent="TextAppearance.Material3.TitleLarge">
		<item name="android:fontFamily">NType82-Headline</item>
		<item name="android:textSize">24sp</item>
	</style>
	<style name="TextAppearance.DCross2000.RowTitle" parent="TextAppearance.Material3.TitleMedium">
		<item name="android:fontFamily">NType82-Headline</item>
		<item name="android:textSize">18sp</item>
	</style>
	<style name="TextAppearance.DCross2000.DrawerBrand" parent="TextAppearance.Material3.HeadlineMedium">
		<item name="android:fontFamily">NType82-Headline</item>
	</style>
	<style name="TextAppearance.DCross2000.Brand.Display" parent="TextAppearance.Material3.HeadlineLarge">
		<item name="android:fontFamily">NType82-Headline</item>
	</style>
	<style name="TextAppearance.DCross2000.BrandSubtitle" parent="TextAppearance.Material3.BodyMedium">
		<item name="android:fontFamily">NType82-Regular</item>
	</style>
	<style name="TextAppearance.DCross2000.Category" parent="TextAppearance.Material3.TitleSmall">
		<item name="android:fontFamily">NType82-Headline</item>
		<item name="android:letterSpacing">0.02</item>
	</style>
	<style name="TextAppearance.DCross2000.DialogTitle" parent="TextAppearance.Material3.HeadlineSmall">
		<item name="android:fontFamily">NType82-Headline</item>
	</style>
	<style name="ThemeOverlay.DCross2000.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="materialAlertDialogTitlePanelStyle">@style/MaterialAlertDialog.Material3.Title.Panel</item>
		<item name="materialAlertDialogTitleIconStyle">@style/MaterialAlertDialog.Material3.Title.Icon</item>
		<item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Material3.Title.Text</item>
		<item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Material3.Body.Text</item>
		<item name="alertDialogStyle">@style/MaterialAlertDialog.Material3</item>
		<item name="android:windowAnimationStyle">@style/MaterialAlertDialog.Material3.Animation</item>
	</style>

	<style name="TextAppearance.DCross2000.BarTitle" parent="TextAppearance.DCross2000.Brand">
		<item name="android:textColor">?android:attr/textColorPrimary</item>
	</style>
	<style name="TextAppearance.DCross2000.BarTitle.OnContainer" parent="TextAppearance.DCross2000.Brand">
		<item name="android:textColor">?attr/colorOnPrimaryContainer</item>
	</style>
	<style name="TextAppearance.DCross2000.BarSubtitle" parent="TextAppearance.Material3.BodyMedium">
		<item name="android:textColor">?android:attr/textColorSecondary</item>
	</style>
	<style name="TextAppearance.DCross2000.BarSubtitle.OnContainer" parent="TextAppearance.DCross2000.BrandSubtitle">
		<item name="android:textColor">?attr/colorOnPrimaryContainer</item>
	</style>

	<style name="Widget.DCross2000.OverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
		<item name="android:src">@drawable/ic_ms_more_vert</item>
		<item name="android:tint">?attr/element_color</item>
		<item name="android:scaleType">fitCenter</item>
	</style>

	<style name="Widget.DCross2000.Card" parent="Widget.Material3.CardView.Elevated">
		<item name="cardCornerRadius">20dp</item>
		<item name="cardElevation">1dp</item>
		<item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
		<item name="strokeWidth">0dp</item>
	</style>
	<style name="TextAppearance.DCross2000.BarTitle.Inverse">
		<item name="android:textColor">?android:attr/textColorPrimaryInverse</item>
	</style>
	<style name="TextAppearance.DCross2000.BarSubtitle.Inverse">
		<item name="android:textColor">?android:attr/textColorSecondaryInverse</item>
	</style>
	<style name="BasicButton">
		<item name="android:background">?attr/selectableItemBackgroundBorderless</item>
	</style>
	<style name="NotificationButton">
		<item name="android:background">?android:selectableItemBackgroundBorderless</item>
		<item name="android:layout_width">46dip</item>
		<item name="android:layout_height">fill_parent</item>
		<item name="android:layout_gravity">center</item>
		<item name="android:scaleType">fitCenter</item>
		<item name="android:padding">2dip</item>
	</style>

	<style name="MoreButton" parent="@style/BasicButton">
		<item name="android:paddingRight">2dp</item>
	</style>

    <style name="PlaybackControl" parent="@style/BasicButton">
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_marginLeft">4dip</item>
        <item name="android:layout_marginRight">4dip</item>
        <item name="android:layout_width">@dimen/Button</item>
        <item name="android:layout_height">@dimen/Button</item>
        <item name="android:contentDescription">@null</item>
    </style>
	
	<style name="PlaybackControl.Small" parent="@style/PlaybackControl">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/playback_button_circle</item>
    </style>

	<style name="PlaybackControl.Secondary" parent="@style/PlaybackControl">
		<item name="android:layout_width">46dp</item>
		<item name="android:layout_height">46dp</item>
		<item name="android:padding">11dp</item>
		<item name="android:background">@drawable/playback_button_circle</item>
	</style>

	<style name="PlaybackControl.Queue" parent="@style/PlaybackControl">
		<item name="android:layout_width">56dp</item>
		<item name="android:layout_height">56dp</item>
		<item name="android:padding">14dp</item>
		<item name="android:background">@drawable/queue_button_bg</item>
	</style>

	<style name="PlaybackControl.Primary" parent="@style/PlaybackControl.Large">
		<item name="android:layout_width">88dp</item>
		<item name="android:layout_height">88dp</item>
		<item name="android:padding">26dp</item>
		<item name="android:elevation">6dp</item>
		<item name="android:background">@drawable/player_play_button</item>
	</style>

	<style name="PlaybackControl.Large" parent="@style/PlaybackControl">
		<item name="android:layout_width">@dimen/Button.Large</item>
		<item name="android:layout_height">@dimen/Button.Large</item>
		<item name="android:paddingLeft">3dp</item>
		<item name="android:paddingRight">3dp</item>
	</style>

	<style name="PlaybackControl.Match" parent="@style/PlaybackControl">
		<item name="android:layout_height">match_parent</item>
		<item name="android:layout_width">wrap_content</item>
		<item name="android:scaleType">fitCenter</item>
	</style>

	<style name="PlaybackControl.BottomBar" parent="@style/PlaybackControl.Match">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_weight">1</item>
	</style>

	<style name="PlaybackControl.BottomBar.Side" parent="@style/PlaybackControl.Match">
		<item name="android:layout_width">40dp</item>
		<item name="android:layout_height">40dp</item>
		<item name="android:padding">9dp</item>
		<item name="android:background">@drawable/playback_button_circle</item>
	</style>

	<style name="PlaybackControl.BottomBar.Circle" parent="@style/PlaybackControl.Match">
		<item name="android:layout_width">46dp</item>
		<item name="android:layout_height">46dp</item>
		<item name="android:layout_gravity">center</item>
		<item name="android:padding">11dp</item>
		<item name="android:background">@drawable/playback_button_circle</item>
	</style>

	<style name="DownloadActionButton" parent="@style/BasicButton">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
		<item name="android:paddingTop">4dip</item>
		<item name="android:paddingBottom">4dip</item>
		<item name="android:paddingRight">4dip</item>
		<item name="android:paddingLeft">4dip</item>
	</style>

	<style name="Widget.DCross2000.ActionSegment" parent="@style/BasicButton">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_height">44dp</item>
		<item name="android:layout_weight">1</item>
		<item name="android:padding">11dp</item>
		<item name="android:background">?attr/selectableItemBackgroundBorderless</item>
		<item name="android:scaleType">fitCenter</item>
	</style>

	<style name="Widget.DCross2000.ActionChip" parent="@style/BasicButton">
		<item name="android:layout_width">44dp</item>
		<item name="android:layout_height">40dp</item>
		<item name="android:padding">9dp</item>
		<item name="android:layout_marginStart">3dp</item>
		<item name="android:layout_marginEnd">3dp</item>
		<item name="android:background">@drawable/action_chip_bg</item>
		<item name="android:scaleType">fitCenter</item>
	</style>

	<style name="DownloadActionImageButton" parent="@style/BasicButton">
		<item name="android:layout_width">44dp</item>
		<item name="android:layout_height">44dp</item>
		<item name="android:padding">10dp</item>
		<item name="android:background">@drawable/overlay_button_circle</item>
	</style>
</resources>