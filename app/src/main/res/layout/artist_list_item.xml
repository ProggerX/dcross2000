<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="72dp"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="20dp"
	android:paddingEnd="12dp">

	<com.proggerx.dcross2000.view.RecyclingImageView
		android:id="@+id/item_art"
		android:layout_width="52dp"
		android:layout_height="52dp"
		android:layout_marginEnd="16dp"
		android:scaleType="centerCrop"
		android:contentDescription="@null"
		app:imageCornerRadius="26dp" />

	<TextView
		android:id="@+id/item_name"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="@android:color/transparent"
		android:ellipsize="end"
		android:singleLine="true"
		android:textAppearance="@style/TextAppearance.DCross2000.RowTitle"
		android:textColor="?android:textColorPrimary" />

	<ImageButton
		android:id="@+id/item_star"
		android:layout_width="@dimen/Star.Small"
		android:layout_height="@dimen/Star.Small"
		android:layout_gravity="center_vertical"
		android:background="@android:color/transparent"
		android:focusable="false"
		android:scaleType="fitCenter"
		android:visibility="gone" />

	<ImageView
		android:id="@+id/item_more"
		style="@style/MoreButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:src="?attr/download_none" />
</LinearLayout>
