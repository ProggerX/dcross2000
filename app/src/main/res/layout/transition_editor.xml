<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transition_from_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.DCross2000.Brand"/>

                <TextView
                    android:id="@+id/transition_to_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.DCross2000.Brand"/>
            </LinearLayout>

            <com.proggerx.dcross2000.view.TransitionCurveView
                android:id="@+id/transition_curve"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/transition_side"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/transition_side_outgoing"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mix.side_outgoing"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/transition_side_incoming"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mix.side_incoming"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/transition_parameter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/transition_parameter_volume"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mix.parameter_volume"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/transition_parameter_tempo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mix.parameter_tempo"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/transition_lead_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>

            <com.proggerx.dcross2000.view.MixWheelView
                android:id="@+id/transition_lead"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/transition_overlap_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>

            <com.proggerx.dcross2000.view.MixWheelView
                android:id="@+id/transition_overlap"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/transition_tail_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>

            <com.proggerx.dcross2000.view.MixWheelView
                android:id="@+id/transition_tail"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/transition_bstart_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>

            <com.proggerx.dcross2000.view.MixWheelView
                android:id="@+id/transition_bstart"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/transition_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mix.requires_cache"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transition_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mix.preview"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transition_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mix.reset"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transition_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mix.delete"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transition_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mix.save"/>

    </LinearLayout>

</LinearLayout>
