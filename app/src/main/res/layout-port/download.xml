<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/download_layout_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">

	<ImageView
		android:id="@+id/player_background"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:alpha="0.38"
		android:contentDescription="@null"
		android:scaleType="centerCrop" />

	<View
		android:id="@+id/player_background_scrim"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/player_bg_scrim" />

	<LinearLayout
		android:id="@+id/download_layout"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

			<LinearLayout
				android:id="@+id/download_overlay_buttons"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginStart="20dp"
				android:layout_marginEnd="20dp"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="2dp"
				android:background="@drawable/action_panel_bg"
				android:divider="@drawable/action_divider"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="6dp"
				android:paddingEnd="6dp"
				android:showDividers="middle">

				<ImageButton
					android:id="@+id/download_shuffle"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="?attr/shuffle" />

				<ImageButton
					android:id="@+id/download_rating_bad"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_thumb_down" />

				<ImageButton
					android:id="@+id/download_star"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_star_border" />

				<ImageButton
					android:id="@+id/download_add_to_playlist"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_add" />

				<ImageButton
					android:id="@+id/download_playback_speed"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_speed" />

				<ImageButton
					android:id="@+id/download_bookmark"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_bookmark_border" />

				<ImageButton
					android:id="@+id/download_rating_good"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_thumb_up" />

				<ImageButton
					android:id="@+id/download_rating_combined"
					style="@style/Widget.DCross2000.ActionSegment"
					android:src="@drawable/ic_ms_thumb_up"
					android:visibility="gone" />
			</LinearLayout>
		<ViewFlipper
			android:id="@+id/download_playlist_flipper"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1">

			<LinearLayout
				android:id="@+id/download_album_art_layout"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:paddingStart="24dp"
				android:paddingEnd="24dp"
				android:paddingTop="10dp"
				android:paddingBottom="6dp">

				<FrameLayout
					android:id="@+id/download_album_art_background"
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:clickable="true">

					<FrameLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_gravity="center">

						<com.proggerx.dcross2000.view.SquareImageView
							android:id="@+id/download_album_art_image"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:elevation="10dp"
							android:scaleType="centerCrop"
							android:contentDescription="@null"
							app:imageCornerRadius="28dp" />

					</FrameLayout>
				</FrameLayout>

				<TextView
					android:id="@+id/download_status"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:ellipsize="end"
					android:gravity="center"
					android:singleLine="true"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:textColor="?attr/colorOnSurfaceVariant" />

				<TextView
					android:id="@+id/download_song_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:ellipsize="end"
					android:gravity="center"
					android:singleLine="true"
					android:textAppearance="@style/TextAppearance.DCross2000.Brand.Display"
					android:textColor="?android:textColorPrimary" />
			</LinearLayout>

			<include layout="@layout/download_playlist" />
		</ViewFlipper>

		<LinearLayout
			android:id="@+id/player_controls"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:layout_marginEnd="10dp"
			android:layout_marginTop="24dp"
			android:layout_marginBottom="14dp"
			android:background="@drawable/player_controls_card"
			android:orientation="vertical"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:paddingTop="10dp"
			android:paddingBottom="10dp">


			<include layout="@layout/download_slider" android:layout_marginTop="10dp" />

			<include layout="@layout/download_media_buttons" android:layout_marginTop="10dp" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
